{
  "name": "@questbridge/host",
  "version": "0.1.0",
  "private": true,
  "description": "QuestBridge local host: state store, chapter pins, WebSocket transport, and OBS serving",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "questbridge-host": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@questbridge/protocol": "0.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
