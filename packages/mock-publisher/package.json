{
  "name": "@questbridge/mock-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "Protocol-level mock Minecraft publisher for QuestBridge development and tests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "mock": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@questbridge/protocol": "0.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
